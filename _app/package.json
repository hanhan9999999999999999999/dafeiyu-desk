{
  "name": "dafeiyu-desk",
  "version": "1.6.3",
  "private": true,
  "description": "大肥鱼 · 桌面 Live2D 伴侣",
  "main": "src/main.js",
  "type": "commonjs",
  "author": "小代码酱",
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://github.com/hanhan9999999999999999999/dafeiyu-desk",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanhan9999999999999999999/dafeiyu-desk.git"
  },
  "scripts": {
    "start": "runtime\\electron.exe .",
    "deploy": "electron-builder --win --x64",
    "build": "node ./node_modules/electron-builder/cli.js --win --x64 && node ./scripts/fix-latest.js",
    "verify:pack": "node scripts/verify-pack.js",
    "verify:packs": "node scripts/verify-packs.js",
    "verify:src": "node scripts/verify-src.js",
    "verify:server": "node scripts/verify-server.js",
    "test": "node scripts/test-pet.js && node scripts/test-settings.js && node scripts/test-menu.js && node scripts/test-update.js && node scripts/test-log.js && node scripts/test-packs.js && node scripts/test-packs-http.js && node scripts/test-diag.js && node scripts/test-settings-schema.js && node scripts/test-tray.js && node scripts/test-curve.js && node scripts/test-ui-bindings.js && node scripts/test-voiceerr.js && node scripts/test-chatfile.js && node scripts/test-tmp.js && node scripts/test-voice-perf.js && node scripts/test-heal.js && node scripts/test-voice-timeline.js && node scripts/test-usage.js",
    "verify:ui": "node scripts/test-ui.js",
    "verify": "node scripts/verify-src.js && node scripts/verify-packs.js && node scripts/verify-pack.js && node scripts/verify-server.js && npm test && node scripts/audit-settings.js && node scripts/test-persist.js && node scripts/audit-network.js && node scripts/audit-privacy.js && node scripts/audit-listeners.js",
    "release:bundle": "node scripts/release-bundle.js",
    "test:install": "node scripts/test-install.js",
    "test:standalone": "node scripts/test-standalone.js",
    "test:persist": "node scripts/test-persist.js",
    "test:packs": "node scripts/test-packs.js",
    "test:packs-http": "node scripts/test-packs-http.js",
    "diag:adapter": "node scripts/diag-adapter.js",
    "soak": "node scripts/soak.js --minutes 10 --every 30",
    "probe:hidden": "node scripts/probe-hidden.js",
    "churn": "node scripts/churn.js --rounds 8",
    "perf": "node scripts/perf.js",
    "perf:1": "node scripts/perf.js --runs 1 --long",
    "probe:empty": "node scripts/probe-empty.js",
    "test:diag": "node scripts/test-diag.js",
    "test:upgrade": "node scripts/test-upgrade.js",
    "probe:import": "node scripts/probe-import.js",
    "test:schema": "node scripts/test-settings-schema.js",
    "test:single": "node scripts/test-single.js",
    "audit:settings": "node scripts/audit-settings.js",
    "probe:settings": "node scripts/probe-settings.js",
    "probe:dpi": "node scripts/probe-dpi.js",
    "test:curve": "node scripts/test-curve.js",
    "probe:adapter": "node scripts/probe-adapter.js",
    "audit:ui": "node scripts/audit-ui-bindings.js",
    "probe:settings-input": "node scripts/probe-settings-input.js",
    "probe:toggles": "node scripts/probe-toggles.js",
    "probe:hotkeys": "node scripts/probe-hotkeys.js",
    "probe:mic": "node scripts/probe-mic.js",
    "test:voiceerr": "node scripts/test-voiceerr.js",
    "probe:voice-out": "node scripts/probe-voice-out.js",
    "probe:reply": "node scripts/probe-reply-stall.js",
    "test:chatfile": "node scripts/test-chatfile.js",
    "probe:chat": "node scripts/probe-chat.js",
    "probe:switch": "node scripts/probe-switch.js",
    "probe:viewbox": "node scripts/probe-viewbox-migrate.js",
    "probe:fault": "node scripts/probe-fault.js",
    "probe:cursor": "node scripts/probe-cursor.js",
    "probe:idle": "node scripts/probe-idle.js",
    "audit:network": "node scripts/audit-network.js",
    "probe:network": "node scripts/probe-network.js",
    "audit:privacy": "node scripts/audit-privacy.js",
    "probe:wipe": "node scripts/probe-wipe.js",
    "probe:welcome": "node scripts/probe-welcome.js",
    "test:tmp": "node scripts/test-tmp.js",
    "clean:tmp": "node scripts/lib/tmp.js",
    "clean:tmp:dry": "node scripts/lib/tmp.js --dry",
    "audit:listeners": "node scripts/audit-listeners.js",
    "probe:leak": "node scripts/probe-leak.js",
    "probe:power": "node scripts/probe-power.js",
    "probe:reconnect": "node scripts/probe-reconnect.js",
    "test:gamemode": "node scripts/test-gamemode.js",
    "test:idle": "node scripts/test-idle-cache.js",
    "test:voice-fast": "node scripts/test-voice-fast.js",
    "test:voice-perf": "node scripts/test-voice-perf.js",
    "test:globals": "node scripts/test-globals.js",
    "test:drag": "node scripts/test-drag-clamp.js",
    "test:settings-bom": "node scripts/test-settings-bom.js",
    "test:heal": "node scripts/test-heal.js",
    "test:voice-timeline": "node scripts/test-voice-timeline.js",
    "test:usage": "node scripts/test-usage.js"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dafeiyu.desk",
    "productName": "大肥鱼",
    "electronVersion": "35.7.5",
    "electronDist": "runtime",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "afterPack": "scripts/afterpack.js",
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/LICENSE.txt",
      "assets/PRIVACY.txt",
      "assets/voice/*.wav",
      "package.json",
      "!**/*.bak*",
      "!_test/**/*",
      "!run.log"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "src"
      },
      {
        "from": "rvc",
        "to": "rvc",
        "filter": [
          "**/**",
          "!__pycache__/**",
          "!*.pyc",
          "!*.pyo",
          "!_tmp/**",
          "!*.log",
          "!*.wav",
          "!*.tmp",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!*.mp3",
          "!models/keqing/**",
          "!models/**/*.pth",
          "!models/*/*.onnx",
          "!models/*/*.index",
          "!**/_dl/**",
          "!py/Lib/site-packages/pip/**",
          "!py/Lib/site-packages/setuptools/**",
          "!py/Lib/site-packages/pkg_resources/**",
          "!py/Lib/test/**",
          "!py/Lib/idlelib/**",
          "!py/Lib/tkinter/**",
          "!py/Lib/turtledemo/**",
          "!py/Lib/ensurepip/**",
          "!py/Lib/site-packages/**/tests",
          "!py/Lib/site-packages/**/tests/**",
          "!py/Lib/site-packages/**/test",
          "!py/Lib/site-packages/**/test/**",
          "!py/Lib/site-packages/**/*.lib",
          "!py/Lib/site-packages/**/*.a",
          "!py/Lib/site-packages/**/include/**",
          "!py/Lib/site-packages/~*/**",
          "!**/_bak_torch/**"
        ]
      },
      {
        "from": "vendor",
        "to": "vendor"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/**",
          "!_asrtest.mjs",
          "!_selftest.mjs",
          "!*.log",
          "!runtime/tts/**",
          "!runtime/asr/**",
          "!models/ggml-large-v3-turbo.bin"
        ]
      },
      {
        "from": "bridge",
        "to": "bridge"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "大肥鱼-${version}-安装包.${ext}",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "大肥鱼",
      "uninstallDisplayName": "大肥鱼",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt",
      "runAfterFinish": true
    }
  }
}
